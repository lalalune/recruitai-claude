{
  "name": "recruitai",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "Local-first lead engine: find SF Bay Area startups that are hiring, plus the people who decide to hire an agency.",
  "license": "MIT",
  "main": "dist/main/index.cjs",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "concurrently -k -n vite,main,electron -c cyan,yellow,green \"bun run dev:renderer\" \"bun run dev:main\" \"bun run dev:electron\"",
    "dev:renderer": "vite",
    "dev:main": "bun run build:main -- --watch",
    "dev:electron": "wait-on tcp:5183 dist/main/index.cjs && electron . --dev",
    "build:main": "esbuild src/main/index.ts --bundle --platform=node --format=cjs --target=node24 --loader:.sql=text --external:electron --outfile=dist/main/index.cjs && esbuild src/main/preload.ts --bundle --platform=node --format=cjs --target=node24 --external:electron --outfile=dist/main/preload.cjs",
    "build:renderer": "vite build",
    "build": "bun run build:main && bun run build:renderer",
    "dist": "bun run build && electron-builder --publish never",
    "dist:mac": "bun run build && electron-builder --mac --publish never",
    "dist:win": "bun run build && electron-builder --win --publish never",
    "dist:linux": "bun run build && electron-builder --linux --publish never",
    "typecheck": "tsc --noEmit",
    "test": "node --test --experimental-strip-types src/**/*.test.ts",
    "seed": "esbuild scripts/seed.ts --bundle --platform=node --format=cjs --target=node24 --loader:.sql=text --external:electron --log-level=error --outfile=dist/seed.cjs && node dist/seed.cjs",
    "smoke": "esbuild scripts/smoke.ts --bundle --platform=node --format=cjs --target=node24 --loader:.sql=text --external:electron --log-level=error --outfile=dist/smoke.cjs && node dist/smoke.cjs"
  },
  "dependencies": {
    "@googleapis/gmail": "17.0.0",
    "@tanstack/react-query": "5.101.4",
    "@tanstack/react-table": "8.21.3",
    "@tanstack/react-virtual": "3.14.8",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "cmdk": "1.1.1",
    "google-auth-library": "10.9.1",
    "lucide-react": "1.27.0",
    "nodemailer": "9.0.3",
    "radix-ui": "1.6.7",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "react-hotkeys-hook": "5.3.3",
    "sonner": "2.0.7",
    "tailwind-merge": "3.6.0",
    "zod": "4.4.3",
    "zustand": "5.0.14"
  },
  "devDependencies": {
    "@tailwindcss/vite": "4.3.3",
    "@types/node": "22.18.13",
    "@types/nodemailer": "7.0.4",
    "@types/react": "19.2.17",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "6.0.4",
    "concurrently": "10.0.4",
    "electron": "43.2.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.1",
    "tailwindcss": "4.3.3",
    "tw-animate-css": "1.4.0",
    "typescript": "5.9.3",
    "vite": "8.1.5",
    "wait-on": "9.1.0"
  }
}
