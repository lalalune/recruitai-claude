# Optional. Everything in the discovery layer is free and needs no keys.

# Where the database and evidence live. Defaults to ./data in dev.
# RECRUITAI_DATA=/Users/you/recruitai-data

# Email verification. Reoon is the recommended default (~$11.90/10k, credits never expire).
# Set this in Settings rather than here if you prefer — it is stored encrypted via the OS keychain.
# REOON_API_KEY=
# BOUNCER_API_KEY=
# MILLIONVERIFIER_API_KEY=

# Optional: lets the draft generator rewrite body prose. It never sees or emits an address.
# ANTHROPIC_API_KEY=
