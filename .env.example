# recruitAI environment variables.
#
# No .env loader ships with the app — export these in your shell (the file is
# documentation, not configuration). Keys are normally entered in Settings, not
# env; the env vars exist so the pipeline can run headlessly without touching
# the operator's keychain.

# Where the database and evidence live. Defaults to ./data in dev, the OS
# userData directory when packaged.
# RECRUITAI_DATA=/Users/you/recruitai-data

# Email verification override (normally set in Settings, stored via the OS
# keychain). Provider is one of: reoon | bouncer | millionverifier.
# RECRUITAI_VERIFIER_PROVIDER=reoon
# RECRUITAI_VERIFIER_KEY=

# Google OAuth "Desktop app" client override (normally set in Settings → Gmail).
# RECRUITAI_GMAIL_CLIENT_ID=
# RECRUITAI_GMAIL_CLIENT_SECRET=

# Dev only: open Chromium DevTools on launch (any non-empty value).
# RECRUITAI_DEVTOOLS=1

# Disposable scratch directory for `bun run smoke` (defaults to ./data/smoke).
# Deliberately separate from RECRUITAI_DATA — the smoke script wipes it.
# RECRUITAI_SMOKE_DATA=./data/smoke

# Set to 1 to enable the live-network tests that `bun run test` skips by default.
# RECRUITAI_NET=1
